{
  "name": "zotero-pubpeer",
  "type": "module",
  "version": "1.0.10",
  "description": "Plugin to show if references in Zotero have PubPeer comments",
  "scripts": {
    "tsc": "tsc --noEmit",
    "prelint": "npm run tsc",
    "lint": "eslint .",
    "prebuild": "npm run lint",
    "build": "node esbuild.js",
    "postbuild": "zp-zipup build zotero-pubpeer",
    "postversion": "git push --follow-tags",
    "release": "zp-release",
    "fetch": "zp-fetch-log",
    "start": "zotero-start"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PubPeerFoundation/pubpeer_zotero_plugin.git"
  },
  "author": {
    "name": "PubPeer Foundation",
    "email": "contact@pubpeer.com"
  },
  "bugs": {
    "url": "https://github.com/PubPeerFoundation/pubpeer_zotero_plugin/issues"
  },
  "homepage": "https://github.com/PubPeerFoundation/pubpeer_zotero_plugin",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "zotero-plugin": "11.0.12"
  },
  "xpi": {
    "name": "Pubpeer Plugin for Zotero",
    "updateLink": "https://github.com/PubPeerFoundation/pubpeer_zotero_plugin/releases/download/v{version}/zotero-pubpeer-{version}.xpi",
    "releaseURL": "https://github.com/PubPeerFoundation/pubpeer_zotero_plugin/releases/download/release/",
    "iconURL": "chrome://zotero-pubpeer/content/skin/pubpeer.svg",
    "minVersion": "7.0.0",
    "maxVersion": "10.*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "bluebird": "^3.7.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "es5-ext@0.10.64": true
  }
}
